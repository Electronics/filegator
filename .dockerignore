# Dependencies — installed during build
node_modules/
vendor/

# Build output — regenerated by npm run build
# dist/index.php is the PHP backend entry point and must be kept
dist/
!dist/index.php

# Runtime data volumes — provided at run time, not baked in
repository/
private/
!private/users.json.blank

# Git and dev tooling
.git/
.github/
.claude/

# Dev/test files
tests/
cypress/
*.md
